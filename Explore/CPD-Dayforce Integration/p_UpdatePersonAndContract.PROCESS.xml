   <types1:Item>
      <types1:EntryId>TUaU8PTn1SEcDVyUTRKb6U-gt-00000005-2026-07-27T17:44:00.000Z::pd.xml</types1:EntryId>
      <types1:Name>p_UpdatePersonAndContract</types1:Name>
      <types1:MimeType>application/xml+process</types1:MimeType>
      <types1:Description>Build guide 4.9. Existing-employee path: full overwrite of the CPD person and contract.</types1:Description>
      <types1:AppliesTo/>
      <types1:Tags/>
      <types1:VersionLabel>1.0</types1:VersionLabel>
      <types1:State>CURRENT</types1:State>
      <types1:ProcessGroup/>
      <types1:CreatedBy>abdul.mannuru@hubbard.com.dev</types1:CreatedBy>
      <types1:CreationDate>2026-07-27T17:44:00Z</types1:CreationDate>
      <types1:ModifiedBy/>
      <types1:PublicationStatus>unpublished</types1:PublicationStatus>
      <types1:Entry>
         <process xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2010/10/avosScreenflow.xsd"
                  xmlns:tfm="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd"
                  xmlns:list="urn:activevos:spi:list:functions"
                  GUID="TUaU8PTn1SEcDVyUTRKb6U"
                  displayName="p_UpdatePersonAndContract"
                  name="p_UpdatePersonAndContract"
                  overrideAPIName="false">
            <parameterSet xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd"/>
            <appliesTo/>
            <description>Scenario 2 (Existing Employee / Update) per the functional design: CPD API 3.2.3 (Update Person, full overwrite) then 3.2.4 (Create/Update Contract). Invoked by p_ProcessOneEmployee only when p_SearchPerson.out_PersonFound = true (build guide 4.7, 4.9).</description>
            <tags/>
            <generator>Informatica Process Designer 11</generator>
            <input>
               <parameter description="Existing CPD VINCI ID from p_SearchPerson" name="in_personVinciId" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Existing contractId from p_SearchPerson" name="in_ExistingContractId" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce FirstName" name="in_FirstName" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce LastName" name="in_LastName" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce PreferredFirstName, if any" name="in_PreferredFirstName" required="false" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce PreferredLastName, if any" name="in_PreferredLastName" required="false" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce BirthDate" name="in_BirthDate" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce Culture.XRefCode (e.g. en-US)" name="in_CultureCode" required="false" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce HomeOrganization.LedgerCode" name="in_HomeOrgLedgerCode" required="false" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Employee's active WorkContracts.Items entry, as untyped XML" name="in_ActiveWorkContract" required="false" type="xml">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="CPD bearer token" name="in_cpd_token" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
            </input>
            <tempFields>
               <field description="" name="tmp_PreferredFirstName" type="string"><options><option name="required">false</option></options></field>
               <field description="" name="tmp_PreferredLastName" type="string"><options><option name="required">false</option></options></field>
               <field description="" name="tmp_mapped_language_code" type="string"><options><option name="required">false</option></options></field>
               <field description="" name="tmp_resolved_COR_ouId" type="string"><options><option name="required">false</option></options></field>
               <field description="" name="tmp_HireDate" type="string"><options><option name="required">false</option></options></field>
               <field description="" name="tmp_EmploymentStatus_EffectiveTo" type="string"><options><option name="required">false</option></options></field>
               <field description="" name="tmp_Job" type="string"><options><option name="required">false</option></options></field>
            </tempFields>
            <notes>Hand-authored against the CPD-Dayforce Functional Design &amp; API Build Guide v1.0 and verified against real IICS Process Designer 11 exports - see README_IICS_BUILD_NOTES.md. Shares the same Open Item on resolved_COR_ouId as p_CreatePersonAndContract (client org cross-reference table pending); the assignment below is a passthrough placeholder, not a real lookup.

VALIDATION FIX (mirrors the same fix in p_CreatePersonAndContract): Process Designer rejects direct inline XPaths into in_ActiveWorkContract (e.g. input.in_ActiveWorkContract/startDate) as a Service step's serviceInput source - "the source field ... is undefined", since in_ActiveWorkContract is untyped xml with no known sub-schema for the validator to resolve against. Fixed by extracting startDate/endDate/operationalJobTitle into declared temp fields (tmp_HireDate/tmp_EmploymentStatus_EffectiveTo/tmp_Job) via XQuery formula assignments first, then referencing those in serviceInput.</notes>
            <deployment skipIfRunning="false" suspendOnFault="false" tracingLevel="none">
               <rest/>
            </deployment>
            <flow id="a">
               <start id="b">
                  <link id="l1" targetId="asn-mapfields"/>
               </start>
               <assignment id="asn-mapfields">
                  <title>Map Dayforce fields to CPD Update Person fields</title>
                  <operation source="formula" to="temp.tmp_PreferredFirstName">
                     <expression language="XQuery">if (empty($input.in_PreferredFirstName) or $input.in_PreferredFirstName = '') then $input.in_FirstName else $input.in_PreferredFirstName</expression>
                  </operation>
                  <operation source="formula" to="temp.tmp_PreferredLastName">
                     <expression language="XQuery">if (empty($input.in_PreferredLastName) or $input.in_PreferredLastName = '') then $input.in_LastName else $input.in_PreferredLastName</expression>
                  </operation>
                  <operation source="formula" to="temp.tmp_mapped_language_code">
                     <expression language="XQuery">if (empty($input.in_CultureCode)) then 'en' else fn:substring($input.in_CultureCode, 1, 2)</expression>
                  </operation>
                  <operation source="formula" to="temp.tmp_resolved_COR_ouId">
                     <expression language="XQuery">$input.in_HomeOrgLedgerCode</expression>
                  </operation>
                  <operation source="formula" to="temp.tmp_HireDate">
                     <expression language="XQuery">string($input.in_ActiveWorkContract/startDate)</expression>
                  </operation>
                  <operation source="formula" to="temp.tmp_EmploymentStatus_EffectiveTo">
                     <expression language="XQuery">string($input.in_ActiveWorkContract/endDate)</expression>
                  </operation>
                  <operation source="formula" to="temp.tmp_Job">
                     <expression language="XQuery">string($input.in_ActiveWorkContract/operationalJobTitle)</expression>
                  </operation>
                  <link id="l2" targetId="svc-updateperson"/>
               </assignment>
               <service id="svc-updateperson">
                  <title>Update CPD person</title>
                  <serviceName>ac-sc-api-cpd:UpdatePerson</serviceName>
                  <serviceGUID>3ek6aEwc6QOkqvy88jyFsM</serviceGUID>
                  <serviceInput>
                     <parameter name="personVinciId" source="field" updatable="true">input.in_personVinciId</parameter>
                     <parameter name="LastName" source="field" updatable="true">input.in_LastName</parameter>
                     <parameter name="FirstName" source="field" updatable="true">input.in_FirstName</parameter>
                     <parameter name="PreferredLastName_or_LastName" source="field" updatable="true">temp.tmp_PreferredLastName</parameter>
                     <parameter name="PreferredFirstName_or_FirstName" source="field" updatable="true">temp.tmp_PreferredFirstName</parameter>
                     <parameter name="BirthDate" source="field" updatable="true">input.in_BirthDate</parameter>
                     <parameter name="mapped_language_code" source="field" updatable="true">temp.tmp_mapped_language_code</parameter>
                     <parameter name="cpd_token" source="field" updatable="true">input.in_cpd_token</parameter>
                  </serviceInput>
                  <link id="l3" targetId="svc-updatecontract"/>
               </service>
               <service id="svc-updatecontract">
                  <title>Update CPD contract</title>
                  <serviceName>ac-sc-api-cpd:CreateOrUpdateContract</serviceName>
                  <serviceGUID>3ek6aEwc6QOkqvy88jyFsM</serviceGUID>
                  <serviceInput>
                     <parameter name="personVinciId" source="field" updatable="true">input.in_personVinciId</parameter>
                     <parameter name="contractId" source="field" updatable="true">input.in_ExistingContractId</parameter>
                     <parameter name="HireDate" source="field" updatable="true">temp.tmp_HireDate</parameter>
                     <parameter name="EmploymentStatus_EffectiveTo" source="field" updatable="true">temp.tmp_EmploymentStatus_EffectiveTo</parameter>
                     <parameter name="resolved_COR_ouId" source="field" updatable="true">temp.tmp_resolved_COR_ouId</parameter>
                     <parameter name="Job" source="field" updatable="true">temp.tmp_Job</parameter>
                     <parameter name="Primary_Work_Assignment_Ledger_Code" source="field" updatable="true">input.in_HomeOrgLedgerCode</parameter>
                     <parameter name="cpd_token" source="field" updatable="true">input.in_cpd_token</parameter>
                  </serviceInput>
                  <link id="l4" targetId="c"/>
               </service>
               <end id="c">
                  <title>End</title>
               </end>
            </flow>
         </process>
      </types1:Entry>
      <types1:GUID>TUaU8PTn1SEcDVyUTRKb6U</types1:GUID>
      <types1:DisplayName>p_UpdatePersonAndContract</types1:DisplayName>
   </types1:Item>
