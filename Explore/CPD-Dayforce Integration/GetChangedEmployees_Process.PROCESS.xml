<aetgt:getResponse xmlns:aetgt="http://schemas.active-endpoints.com/appmodules/repository/2010/10/avrepository.xsd"
                   xmlns:types1="http://schemas.active-endpoints.com/appmodules/repository/2010/10/avrepository.xsd">
   <types1:Item>
      <types1:EntryId>3oBo3euvAbRVfbijBuFPeO-gt-00000001-2026-07-27T17:44:00.000Z::pd.xml</types1:EntryId>
      <types1:Name>GetChangedEmployees_Process</types1:Name>
      <types1:MimeType>application/xml+process</types1:MimeType>
      <types1:Description>Build guide 4.4. Returns the Dayforce XRefCodes changed since the last run.</types1:Description>
      <types1:AppliesTo/>
      <types1:Tags/>
      <types1:VersionLabel>1.0</types1:VersionLabel>
      <types1:State>CURRENT</types1:State>
      <types1:ProcessGroup/>
      <types1:CreatedBy>abdul.mannuru@hubbard.com.dev</types1:CreatedBy>
      <types1:CreationDate>2026-07-27T17:44:00Z</types1:CreationDate>
      <types1:ModifiedBy/>
      <types1:PublicationStatus>unpublished</types1:PublicationStatus>
      <types1:Entry>
         <process xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2010/10/avosScreenflow.xsd"
                  xmlns:tfm="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd"
                  xmlns:list="urn:activevos:spi:list:functions"
                  GUID="3oBo3euvAbRVfbijBuFPeO"
                  displayName="GetChangedEmployees_Process"
                  name="GetChangedEmployees_Process"
                  overrideAPIName="false">
            <parameterSet xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd">
               <parameter name="LastRunTimestamp" direction="in" type="string" description="Orchestrator's last successful run timestamp; empty on first run"/>
               <parameter name="ChangedXRefCodes" direction="out" type="string" isList="true" description="Dayforce XRefCodes changed in the window"/>
               <parameter name="CurrentRunTimestamp" direction="out" type="string" description="Timestamp to persist as next run's LastRunTimestamp"/>
            </parameterSet>
            <appliesTo/>
            <description>Wraps Dayforce APIs 3.1.1 (Get token) and 3.1.2 (Get Changed Employees / delta) behind a single callable sub-process for the Orchestrator (build guide step 4.15, step 1).</description>
            <tags/>
            <generator>Informatica Process Designer 11</generator>
            <notes>Hand-authored against the CPD-Dayforce Functional Design &amp; API Build Guide v1.0. Node types (invoke/dataProcess) follow this repo's documented convention (see README_IICS_BUILD_NOTES.md) - re-verify against your IICS tenant's Process Designer palette before deploying. filterUpdatedStartDate/EndDate window: uses LastRunTimestamp when provided, otherwise defaults to "now minus schedule interval" per build guide 4.4 and 4.16 (widen the window slightly vs. the schedule interval to cover clock drift).</notes>
            <deployment skipIfRunning="false" suspendOnFault="false" tracingLevel="none">
               <rest/>
            </deployment>
            <extData>
               <nvpair name="treatEmptyStringAsNotNull">false</nvpair>
               <nvpair name="treatEmptyObjectListAsArray">true</nvpair>
            </extData>
            <flow id="f1-getchanged">
               <start id="start-getchanged">
                  <link id="l1" targetId="dp-computeWindow"/>
               </start>
               <dataProcess id="dp-computeWindow" title="Compute delta window">
                  <description>filterUpdatedStartDate = LastRunTimestamp if set, else now() minus schedule interval; filterUpdatedEndDate = now(). CurrentRunTimestamp = filterUpdatedEndDate.</description>
                  <expression target="filterUpdatedStartDate">iif(isNull(LastRunTimestamp) or LastRunTimestamp = '', addMinutes(currentTimestamp(), -20), LastRunTimestamp)</expression>
                  <expression target="filterUpdatedEndDate">currentTimestamp()</expression>
                  <expression target="CurrentRunTimestamp">filterUpdatedEndDate</expression>
                  <link id="l2" targetId="inv-token"/>
               </dataProcess>
               <invoke id="inv-token" connector="cnctr-test-dayforce" action="Get token" title="Get Dayforce token">
                  <inputMapping>
                     <map source="processParameter:DayforceUsername" target="df_username"/>
                     <map source="processParameter:DayforcePassword" target="df_password"/>
                  </inputMapping>
                  <outputMapping>
                     <map source="access_token" target="access_token"/>
                  </outputMapping>
                  <link id="l3" targetId="inv-changed"/>
               </invoke>
               <invoke id="inv-changed" connector="cnctr-test-dayforce" action="GetChangedEmployees" title="Get changed employees">
                  <inputMapping>
                     <map source="filterUpdatedStartDate" target="filterUpdatedStartDate"/>
                     <map source="filterUpdatedEndDate" target="filterUpdatedEndDate"/>
                     <map source="access_token" target="access_token"/>
                  </inputMapping>
                  <outputMapping>
                     <map source="response" target="rawChangedEmployeesResponse"/>
                  </outputMapping>
                  <link id="l4" targetId="dp-mapOutput"/>
               </invoke>
               <dataProcess id="dp-mapOutput" title="Extract XRefCode list">
                  <description>Projects rawChangedEmployeesResponse.Data[].XRefCode into ChangedXRefCodes. Exact JSON path depends on the confirmed response shape for the bulk/delta endpoint - validate against a live delta call before use.</description>
                  <expression target="ChangedXRefCodes">list:project(rawChangedEmployeesResponse, 'Data[*].XRefCode')</expression>
                  <link id="l5" targetId="end-getchanged"/>
               </dataProcess>
               <end id="end-getchanged">
                  <title>End</title>
               </end>
            </flow>
         </process>
      </types1:Entry>
      <types1:GUID>3oBo3euvAbRVfbijBuFPeO</types1:GUID>
      <types1:DisplayName>GetChangedEmployees_Process</types1:DisplayName>
   </types1:Item>
   <types1:CurrentServerDateTime>2026-07-27T17:46:15.000Z</types1:CurrentServerDateTime>
</aetgt:getResponse>
