<aetgt:getResponse xmlns:aetgt="http://schemas.active-endpoints.com/appmodules/repository/2010/10/avrepository.xsd"
                   xmlns:types1="http://schemas.active-endpoints.com/appmodules/repository/2010/10/avrepository.xsd">
   <types1:Item>
      <types1:EntryId>ugYTHbESlUs3xY4PcfoFaW-gt-00000004-2026-07-27T17:44:00.000Z::pd.xml</types1:EntryId>
      <types1:Name>p_CreatePersonAndContract</types1:Name>
      <types1:MimeType>application/xml+process</types1:MimeType>
      <types1:Description>Build guide 4.8. New-hire path: creates the CPD person, then the contract.</types1:Description>
      <types1:AppliesTo/>
      <types1:Tags/>
      <types1:VersionLabel>1.0</types1:VersionLabel>
      <types1:State>CURRENT</types1:State>
      <types1:ProcessGroup/>
      <types1:CreatedBy>abdul.mannuru@hubbard.com.dev</types1:CreatedBy>
      <types1:CreationDate>2026-07-27T17:44:00Z</types1:CreationDate>
      <types1:ModifiedBy/>
      <types1:PublicationStatus>unpublished</types1:PublicationStatus>
      <types1:Entry>
         <process xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2010/10/avosScreenflow.xsd"
                  xmlns:tfm="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd"
                  xmlns:list="urn:activevos:spi:list:functions"
                  GUID="ugYTHbESlUs3xY4PcfoFaW"
                  displayName="p_CreatePersonAndContract"
                  name="p_CreatePersonAndContract"
                  overrideAPIName="false">
            <parameterSet xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd"/>
            <appliesTo/>
            <description>Scenario 1 (New Hire / Create) per the functional design: CPD API 3.2.2 (Create Person) then 3.2.4 (Create/Update Contract). Invoked by p_ProcessOneEmployee only when p_SearchPerson.out_PersonFound = false (build guide 4.7, 4.8).</description>
            <tags/>
            <generator>Informatica Process Designer 11</generator>
            <input>
               <parameter description="Dayforce EmployeeNumber" name="in_EmployeeNumber" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce FirstName" name="in_FirstName" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce LastName" name="in_LastName" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce PreferredFirstName, if any" name="in_PreferredFirstName" required="false" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce PreferredLastName, if any" name="in_PreferredLastName" required="false" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce BirthDate" name="in_BirthDate" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce SeniorityDate" name="in_SeniorityDate" required="false" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce Culture.XRefCode (e.g. en-US)" name="in_CultureCode" required="false" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Dayforce HomeOrganization.LedgerCode" name="in_HomeOrgLedgerCode" required="false" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="Employee's active WorkContracts.Items entry, as untyped XML" name="in_ActiveWorkContract" required="false" type="xml">
                  <options><option name="required">false</option></options>
               </parameter>
               <parameter description="CPD bearer token" name="in_cpd_token" required="true" type="string">
                  <options><option name="required">false</option></options>
               </parameter>
            </input>
            <output>
               <field description="VINCI ID generated by CPD Create Person - required by the Orchestrator for the p_WriteVinciId branch" name="out_NewPersonVinciId" type="string">
                  <options><option name="required">false</option></options>
               </field>
               <field description="Contract id used/returned on the Create Contract call" name="out_NewContractId" type="string">
                  <options><option name="required">false</option></options>
               </field>
            </output>
            <tempFields>
               <field description="" name="tmp_PreferredFirstName" type="string"><options><option name="required">false</option></options></field>
               <field description="" name="tmp_PreferredLastName" type="string"><options><option name="required">false</option></options></field>
               <field description="" name="tmp_mapped_language_code" type="string"><options><option name="required">false</option></options></field>
               <field description="" name="tmp_resolved_COR_ouId" type="string"><options><option name="required">false</option></options></field>
            </tempFields>
            <notes>Hand-authored against the CPD-Dayforce Functional Design &amp; API Build Guide v1.0 and verified against real IICS Process Designer 11 exports - see README_IICS_BUILD_NOTES.md.
OPEN ITEMS carried from the design doc (unresolved there too, not introduced by this build):
1) resolved_COR_ouId - mapping Dayforce HomeOrganization.LedgerCode to a CPD organizationalUnitAssignment.ouId requires a client-supplied cross-reference table. The assignment below is a placeholder passthrough of the Dayforce ledger code and MUST be replaced with a real lookup before this can create a valid contract.
2) mapped_language_code - takes the first two characters of Culture.XRefCode (e.g. "en-US" -&gt; "en") as a best-effort default; confirm the full Dayforce-culture-to-CPD-language-ISO-code mapping table with the client.
3) out_NewContractId on the Create path - the design doc's Create/Update Contract call is a single PATCH to an existing {contractId}, which presupposes CPD already issued one on Create Person. This process assumes it comes back on the CreatePerson response body; confirm against a live CPD test call - if not, a distinct Create Contract (POST) call is needed, which is not currently documented.</notes>
            <deployment skipIfRunning="false" suspendOnFault="false" tracingLevel="none">
               <rest/>
            </deployment>
            <flow id="a">
               <start id="b">
                  <link id="l1" targetId="asn-mapfields"/>
               </start>
               <assignment id="asn-mapfields">
                  <title>Map Dayforce fields to CPD Create Person fields</title>
                  <operation source="formula" to="temp.tmp_PreferredFirstName">
                     <expression language="XQuery">if (empty($input.in_PreferredFirstName) or $input.in_PreferredFirstName = '') then $input.in_FirstName else $input.in_PreferredFirstName</expression>
                  </operation>
                  <operation source="formula" to="temp.tmp_PreferredLastName">
                     <expression language="XQuery">if (empty($input.in_PreferredLastName) or $input.in_PreferredLastName = '') then $input.in_LastName else $input.in_PreferredLastName</expression>
                  </operation>
                  <operation source="formula" to="temp.tmp_mapped_language_code">
                     <expression language="XQuery">if (empty($input.in_CultureCode)) then 'en' else fn:substring($input.in_CultureCode, 1, 2)</expression>
                  </operation>
                  <link id="l2" targetId="svc-createperson"/>
               </assignment>
               <service id="svc-createperson">
                  <title>Create CPD person</title>
                  <serviceName>ac-sc-api-cpd:CreatePerson</serviceName>
                  <serviceGUID>3ek6aEwc6QOkqvy88jyFsM</serviceGUID>
                  <serviceInput>
                     <parameter name="EmployeeNumber" source="field" updatable="true">input.in_EmployeeNumber</parameter>
                     <parameter name="LastName" source="field" updatable="true">input.in_LastName</parameter>
                     <parameter name="FirstName" source="field" updatable="true">input.in_FirstName</parameter>
                     <parameter name="PreferredLastName_or_LastName" source="field" updatable="true">temp.tmp_PreferredLastName</parameter>
                     <parameter name="PreferredFirstName_or_FirstName" source="field" updatable="true">temp.tmp_PreferredFirstName</parameter>
                     <parameter name="BirthDate" source="field" updatable="true">input.in_BirthDate</parameter>
                     <parameter name="SeniorityDate" source="field" updatable="true">input.in_SeniorityDate</parameter>
                     <parameter name="mapped_language_code" source="field" updatable="true">temp.tmp_mapped_language_code</parameter>
                     <parameter name="cpd_token" source="field" updatable="true">input.in_cpd_token</parameter>
                  </serviceInput>
                  <link id="l3" targetId="asn-maporg"/>
               </service>
               <assignment id="asn-maporg">
                  <title>Resolve org unit / contract fields (PLACEHOLDER - see Open Item 1 and 3)</title>
                  <operation source="field" to="output.out_NewPersonVinciId">output.personVinciId</operation>
                  <operation source="formula" to="temp.tmp_resolved_COR_ouId">
                     <expression language="XQuery">$input.in_HomeOrgLedgerCode</expression>
                  </operation>
                  <operation source="formula" to="output.out_NewContractId">
                     <expression language="XQuery">if (empty($output.RawResponse//contractId)) then 'TBD_DEFAULT_CONTRACT_ID' else string($output.RawResponse//contractId[1])</expression>
                  </operation>
                  <link id="l4" targetId="svc-createcontract"/>
               </assignment>
               <service id="svc-createcontract">
                  <title>Create CPD contract</title>
                  <serviceName>ac-sc-api-cpd:CreateOrUpdateContract</serviceName>
                  <serviceGUID>3ek6aEwc6QOkqvy88jyFsM</serviceGUID>
                  <serviceInput>
                     <parameter name="personVinciId" source="field" updatable="true">output.out_NewPersonVinciId</parameter>
                     <parameter name="contractId" source="field" updatable="true">output.out_NewContractId</parameter>
                     <parameter name="HireDate" source="field" updatable="true">input.in_ActiveWorkContract/startDate</parameter>
                     <parameter name="EmploymentStatus_EffectiveTo" source="field" updatable="true">input.in_ActiveWorkContract/endDate</parameter>
                     <parameter name="resolved_COR_ouId" source="field" updatable="true">temp.tmp_resolved_COR_ouId</parameter>
                     <parameter name="Job" source="field" updatable="true">input.in_ActiveWorkContract/operationalJobTitle</parameter>
                     <parameter name="Primary_Work_Assignment_Ledger_Code" source="field" updatable="true">input.in_HomeOrgLedgerCode</parameter>
                     <parameter name="cpd_token" source="field" updatable="true">input.in_cpd_token</parameter>
                  </serviceInput>
                  <link id="l5" targetId="c"/>
               </service>
               <end id="c">
                  <title>End</title>
               </end>
            </flow>
         </process>
      </types1:Entry>
      <types1:GUID>ugYTHbESlUs3xY4PcfoFaW</types1:GUID>
      <types1:DisplayName>p_CreatePersonAndContract</types1:DisplayName>
   </types1:Item>
   <types1:CurrentServerDateTime>2026-07-27T17:46:15.000Z</types1:CurrentServerDateTime>
</aetgt:getResponse>
