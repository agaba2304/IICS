      <types1:Entry>
         <businessConnector xmlns="http://schemas.informatica.com/socrates/data-services/2014/05/business-connector-model.xsd"
                            agentOnly="false"
                            debug="false"
                            displayName="cnctr-test-dayforce"
                            label=""
                            name="cnctr-test-dayforce"
                            uuid="590b51ca-5d5b-411a-a762-69b2cbfda28c">
            <description>Dayforce HCM Anywhere REST actions for the CPD-Dayforce employee integration (Functional Design &amp; API Build Guide v1.0, section 3.1).</description>
            <tags/>
            <connectionAttributes xmlns="http://schemas.informatica.com/appmodules/screenflow/2014/04/avosConnectors.xsd"/>
            <actions>
               <action category=""
                       failOnError="true"
                       forSearch="false"
                       label="Get token"
                       maxRedirects="100"
                       name="Get token"
                       preemptiveAuth="true"
                       responseEncoding="">
                  <description>3.1.1 Get OAuth Token. Authenticates against Dayforce's identity server. In production this should be handled by the Connection's OAuth2 config rather than invoked as an explicit process step.</description>
                  <input>
                     <field description="Dayforce API username (from Secure Agent connection / secure parameter, never hardcoded)" name="df_username" type="string"/>
                     <field description="Dayforce API password (from Secure Agent connection / secure parameter, never hardcoded)" name="df_password" type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://dfidconfig.np.dayforcehcm.com/connect/token"
                                        verb="POST">
                        <mutualAuth enabled="false">
                           <keyStore mode="file"/>
                           <keyStorePassword/>
                        </mutualAuth>
                        <httpHeaders>
                           <header name="Content-Type">application/x-www-form-urlencoded</header>
                        </httpHeaders>
                        <body>grant_type=password&amp;amp;companyId=vinciconfig&amp;amp;username={df_username}&amp;amp;password={df_password}&amp;amp;client_id=Dayforce.HCMAnywhere.Client
</body>
                     </restSimpleBinding>
                  </binding>
                  <output>
                     <field description="Bearer token used to authenticate all subsequent Dayforce calls in this run"
                            name="access_token"
                            property="access_token"
                            type="string"/>
                  </output>
                  <responseProcessing enableMultipartParsing="false" processingType="AUTO"/>
               </action>
               <action category=""
                       failOnError="true"
                       forSearch="false"
                       label="GetChangedEmployees"
                       maxRedirects="100"
                       name="GetChangedEmployees"
                       preemptiveAuth="true"
                       responseEncoding="UTF-8">
                  <description>3.1.2 Get Changed Employees (Delta). Returns the XRefCodes of employees modified within [filterUpdatedStartDate, filterUpdatedEndDate). Confirmed working against the live test tenant. Consumed by GetChangedEmployees_Process (build guide 4.4).</description>
                  <input>
                     <field description="Start of the delta window, e.g. the orchestrator's last successful run timestamp" name="filterUpdatedStartDate" type="string"/>
                     <field description="End of the delta window, e.g. now" name="filterUpdatedEndDate" type="string"/>
                     <field description="Bearer token from the Get token action" name="access_token" type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://usconfig261.dayforcehcm.com/api/vinciconfig/V1/Employees?filterUpdatedStartDate={filterUpdatedStartDate}&amp;amp;filterUpdatedEndDate={filterUpdatedEndDate}"
                                        verb="GET">
                        <mutualAuth enabled="false">
                           <keyStore mode="file"/>
                           <keyStorePassword/>
                        </mutualAuth>
                        <httpHeaders>
                           <header name="Accept">application/json</header>
                           <header name="Authorization">Bearer {access_token}</header>
                        </httpHeaders>
                     </restSimpleBinding>
                  </binding>
                  <output/>
                  <responseProcessing enableMultipartParsing="false" processingType="AUTO"/>
               </action>
               <action category=""
                       failOnError="true"
                       forSearch="false"
                       label="GetEmployees"
                       maxRedirects="100"
                       name="GetEmployees"
                       preemptiveAuth="true"
                       responseEncoding="UTF-8">
                  <description>Full (non-delta) employee list. Retained from the original dummy connector for ad hoc/manual use; the scheduled orchestrator uses GetChangedEmployees instead.</description>
                  <input>
                     <field description="Bearer token from the Get token action" name="access_token" type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://usconfig261.dayforcehcm.com/api/vinciconfig/V1/Employees"
                                        verb="GET">
                        <mutualAuth enabled="false">
                           <keyStore mode="file"/>
                           <keyStorePassword/>
                        </mutualAuth>
                        <httpHeaders>
                           <header name="Accept">application/json</header>
                           <header name="Authorization">Bearer {access_token}</header>
                        </httpHeaders>
                     </restSimpleBinding>
                  </binding>
                  <output/>
                  <responseProcessing enableMultipartParsing="false" processingType="AUTO"/>
               </action>
               <action category=""
                       failOnError="true"
                       forSearch="false"
                       label="GetEmployeeDetail"
                       maxRedirects="100"
                       name="GetEmployeeDetail"
                       preemptiveAuth="true"
                       responseEncoding="">
                  <description>3.1.3 Get Employee Detail. Returns full employee data including contract, phone, and job/org assignment via the expand parameter. Confirmed working on the single-employee endpoint only (not the bulk list). Consumed by GetEmployeeDetail_Process (build guide 4.5).</description>
                  <input>
                     <field description="Dayforce XRefCode (employee id) to fetch" name="xrefCode" type="string"/>
                     <field description="Bearer token from the Get token action" name="access_token" type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://usconfig261.dayforcehcm.com/api/vinciconfig/V1/Employees/{xrefCode}?expand=WorkContracts,Contacts,WorkAssignments,EmploymentStatuses,EmployeeManagers"
                                        verb="GET">
                        <mutualAuth enabled="false">
                           <keyStore mode="file"/>
                           <keyStorePassword/>
                        </mutualAuth>
                        <httpHeaders>
                           <header name="Accept">application/json</header>
                           <header name="Authorization">Bearer {access_token}</header>
                        </httpHeaders>
                     </restSimpleBinding>
                  </binding>
                  <output/>
                  <responseProcessing enableMultipartParsing="false" processingType="AUTO"/>
               </action>
               <action category=""
                       failOnError="true"
                       forSearch="false"
                       label="WriteVinciIdToDayforce"
                       maxRedirects="100"
                       name="WriteVinciIdToDayforce"
                       preemptiveAuth="true"
                       responseEncoding="">
                  <description>3.1.4 Write VINCI ID Back to Dayforce. Writes the CPD-generated VINCI ID into Dayforce's EmployeeProperties object. Create path only (build guide 4.10). Property XRefCode below is pending client confirmation - see Open Items.</description>
                  <input>
                     <field description="Dayforce XRefCode (employee id) to update" name="xrefCode" type="string"/>
                     <field description="VINCI ID returned by CPD Create Person" name="personVinciId" type="string"/>
                     <field description="Bearer token from the Get token action" name="access_token" type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://usconfig261.dayforcehcm.com/api/vinciconfig/V1/Employees/{xrefCode}/EmployeeProperties"
                                        verb="PATCH">
                        <mutualAuth enabled="false">
                           <keyStore mode="file"/>
                           <keyStorePassword/>
                        </mutualAuth>
                        <httpHeaders>
                           <header name="Content-Type">application/json</header>
                           <header name="Authorization">Bearer {access_token}</header>
                        </httpHeaders>
                        <body>{
   "Items": [
     {
       "XRefCode": "&lt;VINCI_ID_PROPERTY_XREFCODE_TBD&gt;",
       "PropertyValue": "{personVinciId}"
     }
   ]
}</body>
                     </restSimpleBinding>
                  </binding>
                  <output/>
                  <responseProcessing enableMultipartParsing="false" processingType="AUTO"/>
               </action>
            </actions>
            <objects/>
         </businessConnector>
      </types1:Entry>
