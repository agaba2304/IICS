   <types1:Item>
      <types1:EntryId>KPffEx7EOwfjp7pn7kzZ2M-gt-00000002-2026-07-27T17:44:00.000Z::pd.xml</types1:EntryId>
      <types1:Name>GetEmployeeDetail_Process</types1:Name>
      <types1:MimeType>application/xml+process</types1:MimeType>
      <types1:Description>Build guide 4.5. Returns full Dayforce employee detail (contract, phone, org assignment) for one XRefCode.</types1:Description>
      <types1:AppliesTo/>
      <types1:Tags/>
      <types1:VersionLabel>1.0</types1:VersionLabel>
      <types1:State>CURRENT</types1:State>
      <types1:ProcessGroup/>
      <types1:CreatedBy>abdul.mannuru@hubbard.com.dev</types1:CreatedBy>
      <types1:CreationDate>2026-07-27T17:44:00Z</types1:CreationDate>
      <types1:ModifiedBy/>
      <types1:PublicationStatus>unpublished</types1:PublicationStatus>
      <types1:Entry>
         <process xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2010/10/avosScreenflow.xsd"
                  xmlns:tfm="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd"
                  xmlns:list="urn:activevos:spi:list:functions"
                  GUID="KPffEx7EOwfjp7pn7kzZ2M"
                  displayName="GetEmployeeDetail_Process"
                  name="GetEmployeeDetail_Process"
                  overrideAPIName="false">
            <parameterSet xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd">
               <parameter name="XRefCode" direction="in" type="string" description="Dayforce employee XRefCode"/>
               <parameter name="access_token" direction="in" type="string" description="Dayforce bearer token from GetChangedEmployees_Process/Orchestrator, reused to avoid a redundant token call per employee"/>
               <parameter name="Employee" direction="out" type="string" description="Base employee fields (EmployeeNumber, FirstName, LastName, BirthDate, HireDate, SeniorityDate, Culture, etc.) per sample Dayforce_GetEmployees.xml"/>
               <parameter name="WorkContracts" direction="out" type="string" isList="true" description="Employee.WorkContracts.Items"/>
               <parameter name="Contacts" direction="out" type="string" isList="true" description="Employee.Contacts.Items - phone numbers used by the phone-reconciliation logic"/>
            </parameterSet>
            <appliesTo/>
            <description>Wraps Dayforce API 3.1.3 (Get Employee Detail, expand=WorkContracts,Contacts,WorkAssignments,EmploymentStatuses,EmployeeManagers). Called once per changed XRefCode by the Orchestrator (build guide 4.15, step 3).</description>
            <tags/>
            <generator>Informatica Process Designer 11</generator>
            <notes>Hand-authored against the CPD-Dayforce Functional Design &amp; API Build Guide v1.0 - see README_IICS_BUILD_NOTES.md for schema caveats. The sample response (Dayforce_GetEmployees.xml) provided shows the flat employee shape under root/Data; WorkContracts.Items and Contacts.Items are only populated when the expand parameter is used, which this action's binding always sends - confirm the exact nesting against a live expanded call before final build.</notes>
            <deployment skipIfRunning="false" suspendOnFault="false" tracingLevel="none">
               <rest/>
            </deployment>
            <extData>
               <nvpair name="treatEmptyStringAsNotNull">false</nvpair>
               <nvpair name="treatEmptyObjectListAsArray">true</nvpair>
            </extData>
            <flow id="f2-getdetail">
               <start id="start-getdetail">
                  <link id="l1" targetId="inv-detail"/>
               </start>
               <invoke id="inv-detail" connector="cnctr-test-dayforce" action="GetEmployeeDetail" title="Get employee detail (expanded)">
                  <inputMapping>
                     <map source="XRefCode" target="xrefCode"/>
                     <map source="access_token" target="access_token"/>
                  </inputMapping>
                  <outputMapping>
                     <map source="response" target="rawEmployeeDetailResponse"/>
                  </outputMapping>
                  <link id="l2" targetId="dp-mapDetail"/>
               </invoke>
               <dataProcess id="dp-mapDetail" title="Map response to process outputs">
                  <expression target="Employee">rawEmployeeDetailResponse.Data</expression>
                  <expression target="WorkContracts">rawEmployeeDetailResponse.Data.WorkContracts.Items</expression>
                  <expression target="Contacts">rawEmployeeDetailResponse.Data.Contacts.Items</expression>
                  <link id="l3" targetId="end-getdetail"/>
               </dataProcess>
               <end id="end-getdetail">
                  <title>End</title>
               </end>
            </flow>
         </process>
      </types1:Entry>
      <types1:GUID>KPffEx7EOwfjp7pn7kzZ2M</types1:GUID>
      <types1:DisplayName>GetEmployeeDetail_Process</types1:DisplayName>
