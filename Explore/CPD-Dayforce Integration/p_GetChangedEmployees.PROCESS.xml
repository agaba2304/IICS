<aetgt:getResponse xmlns:aetgt="http://schemas.active-endpoints.com/appmodules/repository/2010/10/avrepository.xsd"
                   xmlns:types1="http://schemas.active-endpoints.com/appmodules/repository/2010/10/avrepository.xsd">
   <types1:Item>
      <types1:EntryId>3oBo3euvAbRVfbijBuFPeO-gt-00000001-2026-07-27T17:44:00.000Z::pd.xml</types1:EntryId>
      <types1:Name>p_GetChangedEmployees</types1:Name>
      <types1:MimeType>application/xml+process</types1:MimeType>
      <types1:Description>Build guide 4.4. Returns the Dayforce XRefCodes changed since the last run.</types1:Description>
      <types1:AppliesTo/>
      <types1:Tags/>
      <types1:VersionLabel>1.0</types1:VersionLabel>
      <types1:State>CURRENT</types1:State>
      <types1:ProcessGroup/>
      <types1:CreatedBy>abdul.mannuru@hubbard.com.dev</types1:CreatedBy>
      <types1:CreationDate>2026-07-27T17:44:00Z</types1:CreationDate>
      <types1:ModifiedBy/>
      <types1:PublicationStatus>unpublished</types1:PublicationStatus>
      <types1:Entry>
         <process xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2010/10/avosScreenflow.xsd"
                  xmlns:tfm="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd"
                  xmlns:list="urn:activevos:spi:list:functions"
                  GUID="3oBo3euvAbRVfbijBuFPeO"
                  displayName="p_GetChangedEmployees"
                  name="p_GetChangedEmployees"
                  overrideAPIName="false">
            <parameterSet xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd"/>
            <appliesTo/>
            <description>Wraps Dayforce APIs 3.1.1 (Get token) and 3.1.2 (Get Changed Employees / delta) behind a single callable sub-process for the Orchestrator (build guide step 4.15, step 1).</description>
            <tags/>
            <generator>Informatica Process Designer 11</generator>
            <input>
               <parameter description="Orchestrator's last successful run timestamp; empty on first run" name="in_LastRunTimestamp" required="false" type="string">
                  <options>
                     <option name="required">false</option>
                  </options>
               </parameter>
               <parameter description="Dayforce API username (secure parameter, never hardcoded)" name="in_DayforceUsername" required="true" type="string">
                  <options>
                     <option name="required">false</option>
                  </options>
               </parameter>
               <parameter description="Dayforce API password (secure parameter, never hardcoded)" name="in_DayforcePassword" required="true" type="string">
                  <options>
                     <option name="required">false</option>
                  </options>
               </parameter>
            </input>
            <output>
               <field description="Dayforce XRefCodes changed in the window" name="out_ChangedXRefCodes" type="string">
                  <options>
                     <option name="multiSelect">true</option>
                     <option name="required">false</option>
                  </options>
               </field>
               <field description="Timestamp to persist as next run's LastRunTimestamp" name="out_CurrentRunTimestamp" type="string">
                  <options>
                     <option name="required">false</option>
                  </options>
               </field>
            </output>
            <tempFields>
               <field description="" name="tmp_filterUpdatedStartDate" type="string">
                  <options>
                     <option name="required">false</option>
                  </options>
               </field>
               <field description="" name="tmp_filterUpdatedEndDate" type="string">
                  <options>
                     <option name="required">false</option>
                  </options>
               </field>
               <field description="" name="tmp_access_token" type="string">
                  <options>
                     <option name="required">false</option>
                  </options>
               </field>
            </tempFields>
            <notes>Hand-authored against the CPD-Dayforce Functional Design &amp; API Build Guide v1.0 and verified against real IICS Process Designer 11 exports (Service/Assignment/subflow/container structure) - see README_IICS_BUILD_NOTES.md. filterUpdatedStartDate/EndDate window: uses in_LastRunTimestamp when provided, otherwise defaults to now minus 20 minutes per build guide 4.4/4.16 (widen slightly vs. the schedule interval to cover clock drift). The exact JSON/XML shape of the delta list response (tmp response Data entries) was not in the sample payloads provided and should be confirmed against a live delta call - the XQuery below assumes the same Data-repeated shape as the single-employee sample (Dayforce_GetEmployees.xml).</notes>
            <deployment skipIfRunning="false" suspendOnFault="false" tracingLevel="none">
               <rest/>
            </deployment>
            <flow id="a">
               <start id="b">
                  <link id="l1" targetId="asn-window"/>
               </start>
               <assignment id="asn-window">
                  <title>Compute delta window</title>
                  <operation source="formula" to="temp.tmp_filterUpdatedStartDate">
                     <expression language="XQuery">if (empty($input.in_LastRunTimestamp) or $input.in_LastRunTimestamp = '') then
  fn:format-dateTime(fn:adjust-dateTime-to-timezone(fn:current-dateTime() - xs:dayTimeDuration('PT20M')), '[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]Z')
else
  $input.in_LastRunTimestamp</expression>
                  </operation>
                  <operation source="formula" to="temp.tmp_filterUpdatedEndDate">
                     <expression language="XQuery">fn:format-dateTime(fn:adjust-dateTime-to-timezone(fn:current-dateTime()), '[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]Z')</expression>
                  </operation>
                  <operation source="field" to="output.out_CurrentRunTimestamp">temp.tmp_filterUpdatedEndDate</operation>
                  <link id="l2" targetId="svc-token"/>
               </assignment>
               <service id="svc-token">
                  <title>Get Dayforce token</title>
                  <serviceName>ac-sc-api-dayforce:Get token</serviceName>
                  <serviceGUID>6hySfDN0kMFjW58a4QsJiN</serviceGUID>
                  <serviceInput>
                     <parameter name="df_username" source="field" updatable="true">input.in_DayforceUsername</parameter>
                     <parameter name="df_password" source="field" updatable="true">input.in_DayforcePassword</parameter>
                  </serviceInput>
                  <link id="l3" targetId="asn-savetoken"/>
               </service>
               <assignment id="asn-savetoken">
                  <title>Save token</title>
                  <operation source="field" to="temp.tmp_access_token">output.access_token</operation>
                  <link id="l4" targetId="svc-changed"/>
               </assignment>
               <service id="svc-changed">
                  <title>Get changed employees</title>
                  <serviceName>ac-sc-api-dayforce:GetChangedEmployees</serviceName>
                  <serviceGUID>6hySfDN0kMFjW58a4QsJiN</serviceGUID>
                  <serviceInput>
                     <parameter name="filterUpdatedStartDate" source="field" updatable="true">temp.tmp_filterUpdatedStartDate</parameter>
                     <parameter name="filterUpdatedEndDate" source="field" updatable="true">temp.tmp_filterUpdatedEndDate</parameter>
                     <parameter name="access_token" source="field" updatable="true">temp.tmp_access_token</parameter>
                  </serviceInput>
                  <link id="l5" targetId="asn-extract"/>
               </service>
               <assignment id="asn-extract">
                  <title>Extract XRefCode list</title>
                  <operation source="formula" to="output.out_ChangedXRefCodes">
                     <expression language="XQuery">for $emp in $output.RawResponse//Data return $emp/XRefCode/text()</expression>
                  </operation>
                  <link id="l6" targetId="c"/>
               </assignment>
               <end id="c">
                  <title>End</title>
               </end>
            </flow>
         </process>
      </types1:Entry>
      <types1:GUID>3oBo3euvAbRVfbijBuFPeO</types1:GUID>
      <types1:DisplayName>p_GetChangedEmployees</types1:DisplayName>
   </types1:Item>
   <types1:CurrentServerDateTime>2026-07-27T17:46:15.000Z</types1:CurrentServerDateTime>
</aetgt:getResponse>
