                                required="false"
                                testWith="IS Architect"
                                type="string"/>
                     <parameter description="Dayforce primary work assignment ledger/cost-center code"
                                name="Primary_Work_Assignment_Ledger_Code"
                                nogen="true"
                                required="false"
                                testWith="KO6.1234"
                                type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://api-tst.vinci-construction.net/hr/v1/persons"
