         "employeePayrollSystemCode": 2
      }},
      "extraInformation": {{
         "costCenterCode": "{ $Primary_Work_Assignment_Ledger_Code }",
         "workScheduleRule": "plan de roulement",
         "hrAreaCode": "hr123",
         "hrSubAreaCode": "HrSub1234",
         "payrollAreaCode": "ANAEL1234",
         "timeManagementScheduleCode": 21,
         "activityTypeCode": "3",
         "contractExternalIdentifier": "piXID1234VCF",
         "supplierExternalIdentifierId": "S4-Suppliers-12222",
