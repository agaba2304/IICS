<aetgt:getResponse xmlns:aetgt="http://schemas.active-endpoints.com/appmodules/repository/2010/10/avrepository.xsd"
                   xmlns:types1="http://schemas.active-endpoints.com/appmodules/repository/2010/10/avrepository.xsd">
   <types1:Item>
      <types1:EntryId>TUaU8PTn1SEcDVyUTRKb6U-gt-00000005-2026-07-27T17:44:00.000Z::pd.xml</types1:EntryId>
      <types1:Name>UpdatePersonAndContract_Process</types1:Name>
      <types1:MimeType>application/xml+process</types1:MimeType>
      <types1:Description>Build guide 4.9. Existing-employee path: full overwrite of the CPD person and contract.</types1:Description>
      <types1:AppliesTo/>
      <types1:Tags/>
      <types1:VersionLabel>1.0</types1:VersionLabel>
      <types1:State>CURRENT</types1:State>
      <types1:ProcessGroup/>
      <types1:CreatedBy>abdul.mannuru@hubbard.com.dev</types1:CreatedBy>
      <types1:CreationDate>2026-07-27T17:44:00Z</types1:CreationDate>
      <types1:ModifiedBy/>
      <types1:PublicationStatus>unpublished</types1:PublicationStatus>
      <types1:Entry>
         <process xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2010/10/avosScreenflow.xsd"
                  xmlns:tfm="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd"
                  xmlns:list="urn:activevos:spi:list:functions"
                  GUID="TUaU8PTn1SEcDVyUTRKb6U"
                  displayName="UpdatePersonAndContract_Process"
                  name="UpdatePersonAndContract_Process"
                  overrideAPIName="false">
            <parameterSet xmlns="http://schemas.active-endpoints.com/appmodules/screenflow/2021/04/taskflowModel.xsd">
               <parameter name="Employee" direction="in" type="string" description="Base employee fields from GetEmployeeDetail_Process"/>
               <parameter name="WorkContracts" direction="in" type="string" isList="true" description="Employee.WorkContracts.Items from GetEmployeeDetail_Process"/>
               <parameter name="personVinciId" direction="in" type="string" description="Existing VINCI ID from SearchPerson_Process"/>
               <parameter name="ExistingContractId" direction="in" type="string" description="Existing contractId from SearchPerson_Process"/>
               <parameter name="cpd_token" direction="in" type="string" description="CPD bearer token"/>
            </parameterSet>
            <appliesTo/>
            <description>Scenario 2 (Existing Employee / Update) per the functional design: CPD API 3.2.3 (Update Person, full overwrite) then 3.2.4 (Create/Update Contract). Invoked by the Orchestrator only when SearchPerson_Process.PersonFound = true (build guide 4.7, 4.9, 4.15 step 4).</description>
            <tags/>
            <generator>Informatica Process Designer 11</generator>
            <notes>Hand-authored against the CPD-Dayforce Functional Design &amp; API Build Guide v1.0 - see README_IICS_BUILD_NOTES.md for schema caveats. Shares the same Open Item on resolved_COR_ouId as CreatePersonAndContract_Process (client org cross-reference table pending); dp-mapOrg below is a passthrough placeholder, not a real lookup.</notes>
            <deployment skipIfRunning="false" suspendOnFault="false" tracingLevel="none">
               <rest/>
            </deployment>
            <extData>
               <nvpair name="treatEmptyStringAsNotNull">false</nvpair>
               <nvpair name="treatEmptyObjectListAsArray">true</nvpair>
            </extData>
            <flow id="f5-update">
               <start id="start-update">
                  <link id="l1" targetId="dp-mapUpdateFields"/>
               </start>
               <dataProcess id="dp-mapUpdateFields" title="Map Dayforce fields to CPD Update Person fields">
                  <expression target="PreferredFirstName_or_FirstName">iif(isNull(Employee.PreferredFirstName) or Employee.PreferredFirstName = '', Employee.FirstName, Employee.PreferredFirstName)</expression>
                  <expression target="PreferredLastName_or_LastName">iif(isNull(Employee.PreferredLastName) or Employee.PreferredLastName = '', Employee.LastName, Employee.PreferredLastName)</expression>
                  <expression target="mapped_language_code">substring(Employee.Culture.XRefCode, 1, 2)</expression>
                  <expression target="resolved_COR_ouId">Employee.HomeOrganization.LedgerCode</expression>
                  <link id="l2" targetId="inv-updatePerson"/>
               </dataProcess>
               <invoke id="inv-updatePerson" connector="cnctr_cpd_get" action="UpdatePerson" title="Update CPD person">
                  <inputMapping>
                     <map source="personVinciId" target="personVinciId"/>
                     <map source="Employee.LastName" target="LastName"/>
                     <map source="Employee.FirstName" target="FirstName"/>
                     <map source="PreferredLastName_or_LastName" target="PreferredLastName_or_LastName"/>
                     <map source="PreferredFirstName_or_FirstName" target="PreferredFirstName_or_FirstName"/>
                     <map source="Employee.BirthDate" target="BirthDate"/>
                     <map source="mapped_language_code" target="mapped_language_code"/>
                     <map source="cpd_token" target="cpd_token"/>
                  </inputMapping>
                  <link id="l3" targetId="inv-updateContract"/>
               </invoke>
               <invoke id="inv-updateContract" connector="cnctr_cpd_get" action="CreateOrUpdateContract" title="Update CPD contract">
                  <inputMapping>
                     <map source="personVinciId" target="personVinciId"/>
                     <map source="ExistingContractId" target="contractId"/>
                     <map source="list:first(WorkContracts, 'isActive = true').startDate" target="HireDate"/>
                     <map source="list:first(WorkContracts, 'isActive = true').endDate" target="EmploymentStatus_EffectiveTo"/>
                     <map source="resolved_COR_ouId" target="resolved_COR_ouId"/>
                     <map source="list:first(WorkContracts, 'isActive = true').operationalJobTitle" target="Job"/>
                     <map source="Employee.HomeOrganization.LedgerCode" target="Primary_Work_Assignment_Ledger_Code"/>
                     <map source="cpd_token" target="cpd_token"/>
                  </inputMapping>
                  <link id="l4" targetId="end-update"/>
               </invoke>
               <end id="end-update">
                  <title>End</title>
               </end>
            </flow>
         </process>
      </types1:Entry>
      <types1:GUID>TUaU8PTn1SEcDVyUTRKb6U</types1:GUID>
      <types1:DisplayName>UpdatePersonAndContract_Process</types1:DisplayName>
   </types1:Item>
   <types1:CurrentServerDateTime>2026-07-27T17:46:15.000Z</types1:CurrentServerDateTime>
</aetgt:getResponse>
