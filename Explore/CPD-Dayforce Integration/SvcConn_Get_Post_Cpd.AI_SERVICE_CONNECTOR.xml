               <action category=""
                       failOnError="true"
                       forSearch="false"
                       label="SearchPersonByExtId"
                       maxRedirects="100"
                       name="SearchPersonByExtId"
                       preemptiveAuth="true"
                       responseEncoding="">
                  <description>3.2.1 Search Person (Interface i639), Ext Id / VINCI ID match. Matches on the external identifier pair (extSystemId=11 for Dayforce, per the Create Person payload) rather than name+DOB. NOTE (from design doc): this criteria only finds a person once a VINCI ID/ext id has already been assigned by a prior run - it cannot by itself distinguish a true brand-new hire from an API/timing miss, so PersonFound=false is treated as "create" per the functional scenarios. Consumed by p_SearchPerson (build guide 4.6).</description>
                  <input>
                     <parameter description="Dayforce EmployeeNumber, used as the CPD external identifier value"
                                name="EmployeeNumber"
                                required="false"
                                type="string"/>
                     <parameter description="CPD API bearer token"
                                name="cpd_token"
                                required="false"
                                type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://{cpd-host}/v1/persons?extId={EmployeeNumber}&amp;amp;extSystemId=11"
                                        verb="GET">
                        <mutualAuth enabled="false">
                           <keyStore mode="file"/>
                           <keyStorePassword/>
                        </mutualAuth>
                        <httpHeaders>
                           <header name="Accept">application/json</header>
                           <header name="Authorization">Bearer {cpd_token}</header>
                        </httpHeaders>
                     </restSimpleBinding>
                  </binding>
                  <output/>
                  <responseProcessing enableMultipartParsing="false" processingType="AUTO"/>
               </action>
               <action category=""
                       failOnError="true"
                       forSearch="false"
                       label="CreatePerson"
                       maxRedirects="100"
                       name="CreatePerson"
                       preemptiveAuth="true"
                       responseEncoding="">
                  <description>3.2.2 Create Person (Interface i619). CPD generates and returns a new personVinciId. Consumed by p_CreatePersonAndContract (build guide 4.8).</description>
                  <input>
                     <parameter description="Dayforce EmployeeNumber"
                                name="EmployeeNumber"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce LastName"
                                name="LastName"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce FirstName"
                                name="FirstName"
                                required="false"
                                type="string"/>
                     <parameter description="Preferred last name, defaults to LastName if not set in Dayforce"
                                name="PreferredLastName_or_LastName"
                                required="false"
                                type="string"/>
                     <parameter description="Preferred first name, defaults to FirstName if not set in Dayforce"
                                name="PreferredFirstName_or_FirstName"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce BirthDate"
                                name="BirthDate"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce SeniorityDate"
                                name="SeniorityDate"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce culture/locale mapped to a CPD language ISO code"
                                name="mapped_language_code"
                                required="false"
                                type="string"/>
                     <parameter description="CPD API bearer token"
                                name="cpd_token"
                                required="false"
                                type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://{cpd-host}/v1/persons"
                                        verb="POST">
                        <mutualAuth enabled="false">
                           <keyStore mode="file"/>
                           <keyStorePassword/>
                        </mutualAuth>
                        <httpHeaders>
                           <header name="Content-Type">application/json</header>
                           <header name="Authorization">Bearer {cpd_token}</header>
                        </httpHeaders>
                        <body>{
   "externalIdentifiers": [{ "extId": "{EmployeeNumber}", "extSystemId": 11 }],
   "birthLastName": "{LastName}",
   "birthFirstName": "{FirstName}",
   "preferredLastName": "{PreferredLastName_or_LastName}",
   "preferredFirstName": "{PreferredFirstName_or_FirstName}",
   "birthDate": "{BirthDate}",
   "salutationCode": "Undefined",
   "groupEntryDate": "{SeniorityDate}",
   "preferredLanguageIsoCode": "{mapped_language_code}",
   "directoryDisplayMode": 1
}</body>
                     </restSimpleBinding>
                  </binding>
                  <output>
                     <field description="CPD-generated VINCI ID for the new person"
                            name="personVinciId"
                            property="personVinciId"
                            type="string"/>
                  </output>
                  <responseProcessing enableMultipartParsing="false" processingType="AUTO"/>
               </action>
               <action category=""
                       failOnError="true"
                       forSearch="false"
                       label="UpdatePerson"
                       maxRedirects="100"
                       name="UpdatePerson"
                       preemptiveAuth="true"
                       responseEncoding="">
                  <description>3.2.3 Update Person (Interface i619). Full overwrite of person fields for an existing VINCI ID. Consumed by p_UpdatePersonAndContract (build guide 4.9).</description>
                  <input>
                     <parameter description="Existing CPD VINCI ID for this person"
                                name="personVinciId"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce LastName"
                                name="LastName"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce FirstName"
                                name="FirstName"
                                required="false"
                                type="string"/>
                     <parameter description="Preferred last name, defaults to LastName if not set in Dayforce"
                                name="PreferredLastName_or_LastName"
                                required="false"
                                type="string"/>
                     <parameter description="Preferred first name, defaults to FirstName if not set in Dayforce"
                                name="PreferredFirstName_or_FirstName"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce BirthDate"
                                name="BirthDate"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce culture/locale mapped to a CPD language ISO code"
                                name="mapped_language_code"
                                required="false"
                                type="string"/>
                     <parameter description="CPD API bearer token"
                                name="cpd_token"
                                required="false"
                                type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://{cpd-host}/v1/persons/{personVinciId}"
                                        verb="PATCH">
                        <mutualAuth enabled="false">
                           <keyStore mode="file"/>
                           <keyStorePassword/>
                        </mutualAuth>
                        <httpHeaders>
                           <header name="Content-Type">application/json</header>
                           <header name="Authorization">Bearer {cpd_token}</header>
                        </httpHeaders>
                        <body>{
   "birthLastName": "{LastName}",
   "birthFirstName": "{FirstName}",
   "preferredLastName": "{PreferredLastName_or_LastName}",
   "preferredFirstName": "{PreferredFirstName_or_FirstName}",
   "birthDate": "{BirthDate}",
   "preferredLanguageIsoCode": "{mapped_language_code}"
}</body>
                     </restSimpleBinding>
                  </binding>
                  <output/>
                  <responseProcessing enableMultipartParsing="false" processingType="AUTO"/>
               </action>
               <action category=""
                       failOnError="true"
                       forSearch="false"
                       label="CreateOrUpdateContract"
                       maxRedirects="100"
                       name="CreateOrUpdateContract"
                       preemptiveAuth="true"
                       responseEncoding="">
                  <description>3.2.4 Create / Update Contract. Single PATCH endpoint used on both the Create and Update paths. OPEN ITEM (design doc): for a brand-new person CPD has not yet issued a contractId, so the Create path's contractId source needs client confirmation (e.g. CPD auto-creates a default contract on person creation, or contractId is client-supplied for upsert) - see Open Items. Consumed by p_CreatePersonAndContract and p_UpdatePersonAndContract (build guide 4.8-4.9).</description>
                  <input>
                     <parameter description="CPD VINCI ID for this person"
                                name="personVinciId"
                                required="false"
                                type="string"/>
                     <parameter description="CPD contract id (existing on Update; TBD source on Create - see Open Items)"
                                name="contractId"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce HireDate"
                                name="HireDate"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce EmploymentStatus effective-to date"
                                name="EmploymentStatus_EffectiveTo"
                                required="false"
                                type="string"/>
                     <parameter description="Resolved CPD organizational unit id for this employee's Dayforce org (COR)"
                                name="resolved_COR_ouId"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce Job title"
                                name="Job"
                                required="false"
                                type="string"/>
                     <parameter description="Dayforce primary work assignment ledger/cost-center code"
                                name="Primary_Work_Assignment_Ledger_Code"
                                required="false"
                                type="string"/>
                     <parameter description="CPD API bearer token"
                                name="cpd_token"
                                required="false"
                                type="string"/>
                  </input>
                  <binding>
                     <restSimpleBinding multiUsing="semicolonSeparated"
                                        url="https://{cpd-host}/v1/persons/{personVinciId}/contracts/{contractId}"
                                        verb="PATCH">
                        <mutualAuth enabled="false">
                           <keyStore mode="file"/>
                           <keyStorePassword/>
                        </mutualAuth>
                        <httpHeaders>
                           <header name="Content-Type">application/json</header>
                           <header name="Authorization">Bearer {cpd_token}</header>
                        </httpHeaders>
                        <body>{
   "startDate": "{HireDate}",
   "endDate": "{EmploymentStatus_EffectiveTo}",
   "staffTypeCode": 1,
   "contractTypeCode": "Permanent",
   "isLocalContract": false,
   "organizationalUnitAssignment": { "ouId": "{resolved_COR_ouId}" },
   "operationalJobTitle": "{Job}",
   "payrollJobTitle": "{Job}",
   "costCenterCode": "{Primary_Work_Assignment_Ledger_Code}"
}</body>
                     </restSimpleBinding>
                  </binding>
                  <output/>
                  <responseProcessing enableMultipartParsing="false" processingType="AUTO"/>
               </action>
